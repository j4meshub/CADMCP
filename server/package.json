{
    "name": "cadmcp-server",
    "version": "2.0.0",
    "description": "通用 MCP stdio 服务器，用于通过 CADMCP 控制 AutoCAD 2022",
    "main": "build/index.js",
    "type": "module",
    "bin": {
        "cadmcp-server": "./build/index.js"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "clean": "rimraf build",
        "prebuild": "npm run clean && node scripts/generate-build-info.mjs",
        "build": "tsc",
        "test": "npm run build && node --test",
        "mcp:list": "node scripts/mcp-local-client.mjs list",
        "mcp:call": "node scripts/mcp-local-client.mjs call",
        "prepublishOnly": "npm test"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/j4meshub/CADMCP.git"
    },
    "keywords": [
        "mcp",
        "autocad",
        "autodesk",
        "claude",
        "ai",
        "cad",
        "drawing"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/j4meshub/CADMCP/issues"
    },
    "homepage": "https://github.com/j4meshub/CADMCP#readme",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "rimraf": "^5.0.10",
        "typescript": "^5.8.2"
    }
}
