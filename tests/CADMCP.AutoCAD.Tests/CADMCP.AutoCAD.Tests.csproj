<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Keep an already-loaded diagnostic DLL untouched while compiling follow-ups. -->
    <OutputPath Condition="'$(HostTestOutput)' != ''">$(HostTestOutput)</OutputPath>
    <AssemblyName Condition="'$(HostTestAssembly)' != ''">$(HostTestAssembly)</AssemblyName>
    <AutoCadDir Condition="'$(ACAD2022_DIR)' != ''">$(ACAD2022_DIR)</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2022</AutoCadDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../plugin/CADMCP.Plugin.csproj" Private="false" />
    <ProjectReference Include="../../commandset/CADMCP.CommandSet.csproj" Private="false" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCadDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCadDir)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AutoCadDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
